<?xml version="1.0" encoding="utf-8"?>

<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <rule name="AppOffline_HTML" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{DOCUMENT_ROOT}\app_offline.html" matchType="IsFile" />
            <add input="{URL}" pattern="^/app_offline\.html$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/app_offline.html" />
        </rule>
        <rule name="AppOffline_HTM" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{DOCUMENT_ROOT}\app_offline.htm" matchType="IsFile" />
            <add input="{URL}" pattern="^/app_offline\.htm$" negate="true" />
          </conditions>
          <action type="Rewrite" url="/app_offline.htm" />
        </rule>
      </rules>
    </rewrite>

    <handlers>
      <add name="OfflineHtmlHandler" path="app_offline.html" verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
      <add name="OfflineHtmHandler" path="app_offline.htm" verb="*" modules="StaticFileModule" resourceType="File" requireAccess="Read" />
      <remove name="StaticFile" />
      <add name="httpPlatformHandler" path="*" verb="*"
           modules="httpPlatformHandler" resourceType="Unspecified" requireAccess="Script" />
    </handlers>

    <httpPlatform
      processPath="C:\Program Files\nodejs\node.exe"
      arguments="--preserve-symlinks --preserve-symlinks-main .\server.js"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\node"
      startupTimeLimit="120"
      requestTimeout="00:04:00"
      processesPerApplication="1"
      rapidFailsPerMinute="10">
      <environmentVariables>
        <environmentVariable name="PORT"     value="%HTTP_PLATFORM_PORT%" />
        <environmentVariable name="HOSTNAME" value="0.0.0.0" />
        <environmentVariable name="NODE_ENV" value="production" />
        <environmentVariable name="SESSION_COOKIE_SECURE" value="false" />
      </environmentVariables>
    </httpPlatform>

    <security>
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600" />
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
